# Copy to .env and fill in before running `docker compose up --build`.

# Required
JWT_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
ADMIN_PASSWORD=choose-a-strong-password

# Optional
ADMIN_EMAIL=admin@foodos.in
DB_PASSWORD=foodos
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Notification emails (defaults send to the bundled Mailpit inbox at http://localhost:8025)
NOTIFY_FROM=no-reply@foodos.in
NOTIFY_TO=hello@foodos.in
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
